{
  "compilerOptions": {
    "target":            "ES2017",
    "module":            "CommonJS",
    "lib":               ["ES2017", "DOM"],
    "outDir":            "./dist",
    "rootDir":           "./src",
    "strict":            true,
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true,
    "esModuleInterop":   true,
    "skipLibCheck":      true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
